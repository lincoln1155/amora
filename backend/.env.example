# Senha de login (única, compartilhada)
APP_PASSWORD=troque_essa_senha

# Chave secreta usada em geração de token. Gere uma forte em prod (ex: openssl rand -hex 32)
SECRET_KEY=troque_essa_chave_secreta

# OpenWeatherMap (https://openweathermap.org/api). Vazio = widget de clima desativado.
WEATHER_API_KEY=
DEFAULT_CITY=São Paulo

# Banco de dados. Em prod (Fly.io) usar volume persistente: sqlite:////data/amora.db
DATABASE_URL=sqlite:///./amora.db

# Em produção (HTTPS) deve ser 1, ativando o flag Secure no cookie de sessão.
# Em dev local (HTTP) deixar 0, senão o cookie não é enviado.
IS_PRODUCTION=0

# Origens permitidas pelo CORS (separadas por vírgula). Em deploy monolítico
# (frontend e API mesmo domínio) pode ficar vazio. Em dev cobre o Vite.
CORS_ORIGINS=http://localhost:5173
